{"userId":"8q9toMgSZw7vfIA9","userEmail":"ananya_1792422660738@dairytech.in","adulterantSlug":"urea","adulterantName":"Urea / Ammonium Sulphate","imageUrl":"/uploads/strip-1792422661175-888339450.png","sampledColorHex":"#B2AFA0","sampledColorRgb":[178,175,160],"detectedStatus":"PURE","confidenceScore":93,"distanceToPure":12,"distanceToAdulterated":154,"milkSource":"Organic Valley Co-op","labTerminology":"NEGATIVE","chemicalReport":{"purpose":"Added illegally to artificially boost non-protein nitrogen, falsifying SNF (Solids-Not-Fat) and protein readings.","snfImpact":"Artificially elevates calculated SNF readings by up to 2.5% to deceive standard refractometer and lactometer checks.","densityImpact":"Slightly increases specific gravity to conceal heavy water dilution.","chemicalMechanism":"p-Dimethylaminobenzaldehyde (DMAB) condensation reaction in acidic media forming a distinctive lemon-yellow chromogen.","healthHazards":["Severe nephrotoxicity and progressive chronic kidney failure","Gastric ulceration and irritation of intestinal mucosa","Metabolic acidosis and cellular dehydration","Forms carcinogenic nitrosamines when combined with nitrate contaminants"],"fssaiLimit":"Max permissible natural urea in milk: 700 ppm (70 mg/100ml). Any synthetic addition is strictly illegal."},"notes":"","sampleName":"Control Pure Sample","createdAt":{"$$date":1792422661186},"_id":"YXg3343wOSJIY1Vy"}
{"userId":"guest","userEmail":"guest@milkanalysis.local","adulterantSlug":"starch","adulterantName":"Starch / Maltodextrin","imageUrl":"/uploads/strip-1792408872712-779864508.png","sampledColorHex":"#0E0D0A","sampledColorRgb":[14,13,10],"detectedStatus":"ADULTERATED","confidenceScore":99,"distanceToPure":198,"distanceToAdulterated":0,"chemicalReport":{"purpose":"Used to thicken diluted milk, restoring viscosity, creaminess, and lactometer density after water dilution.","snfImpact":"Falsely restores total solid readings by adding complex carbohydrates instead of natural milk fat and proteins.","densityImpact":"Increases specific gravity from watered readings (<1.026) back into the normal range (1.028–1.032 g/cm³).","chemicalMechanism":"Iodine-starch inclusion reaction: Triiodide (I₃⁻) ions insert into the amylose helix, creating an intense dark blue-black charge transfer complex.","healthHazards":["Rapid blood glucose spikes, dangerous for diabetic individuals","Severe indigestion, diarrhea, and colic in infants","Prevents absorption of natural calcium and casein proteins in the gastrointestinal tract","Promotes rapid microbial fermentation and souring"],"fssaiLimit":"Nil tolerance (0.0%). Any presence of external starch or maltodextrin indicates adulteration."},"notes":"","sampleName":"Starch Suspect Milk","createdAt":{"$$date":1792408872718},"_id":"crdsNcd9G2byGXzU"}
{"userId":"eUuhMyzhWCwO8Cn8","userEmail":"analyst_1792422937432@milklab.in","adulterantSlug":"detergent","adulterantName":"Detergent / Commercial Soap","imageUrl":"/uploads/strip-1792422937811-690805316.png","sampledColorHex":"#3A3B39","sampledColorRgb":[58,59,57],"detectedStatus":"ADULTERATED","confidenceScore":99,"distanceToPure":180,"distanceToAdulterated":0,"milkSource":"Fresh Farm Dairy","labTerminology":"POSITIVE","chemicalReport":{"purpose":"Added to create artificial dense froth, emulsify cheap vegetable oils with water, and produce synthetic milk.","snfImpact":"Distorts standard colloidal balance and alters fat globule dispersion properties.","densityImpact":"Maintains uniform suspension of adulterated fats without spontaneous phase separation.","chemicalMechanism":"Anionic surfactant displacement reaction with cationic dye (e.g., bromocresol purple or pinacyanol) resulting in a dark slate-blue precipitation.","healthHazards":["Corrosive injury to esophagus, stomach lining, and intestines","Acute alkaline gastroenteritis and persistent vomiting","Alkaline poisoning causing disruption of systemic enzyme pathways","Chronic toxic stress on liver filtration systems"],"fssaiLimit":"Zero tolerance (0.0%). Absolutely prohibited in food products."},"notes":"","sampleName":"Detergent - Right Strip (Adulterated)","createdAt":{"$$date":1792422937816},"_id":"doRXZHTG6ZdeY0UX"}

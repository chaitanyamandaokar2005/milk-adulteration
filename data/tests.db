{"userId":"guest","userEmail":"guest@milkanalysis.local","adulterantSlug":"detergent","adulterantName":"Detergent / Commercial Soap","imageUrl":"/uploads/strip-1792408885661-919859249.png","sampledColorHex":"#3E3F3D","sampledColorRgb":[62,63,61],"detectedStatus":"ADULTERATED","confidenceScore":99,"distanceToPure":175,"distanceToAdulterated":0,"chemicalReport":{"purpose":"Added to create artificial dense froth, emulsify cheap vegetable oils with water, and produce synthetic milk.","snfImpact":"Distorts standard colloidal balance and alters fat globule dispersion properties.","densityImpact":"Maintains uniform suspension of adulterated fats without spontaneous phase separation.","chemicalMechanism":"Anionic surfactant displacement reaction with cationic dye (e.g., bromocresol purple or pinacyanol) resulting in a dark slate-blue precipitation.","healthHazards":["Corrosive injury to esophagus, stomach lining, and intestines","Acute alkaline gastroenteritis and persistent vomiting","Alkaline poisoning causing disruption of systemic enzyme pathways","Chronic toxic stress on liver filtration systems"],"fssaiLimit":"Zero tolerance (0.0%). Absolutely prohibited in food products."},"notes":"","sampleName":"Milk Sample","createdAt":{"$$date":1792408885669},"_id":"tNpACcX7PMNawzzR"}
{"userId":"eWfNO4AfHG7awdav","userEmail":"annabond2704@gmail.com","adulterantSlug":"starch","adulterantName":"Starch / Maltodextrin","imageUrl":"/uploads/strip-1792416604117-992820988.jpeg","sampledColorHex":"#180810","sampledColorRgb":[24,8,16],"detectedStatus":"ADULTERATED","confidenceScore":91,"distanceToPure":195,"distanceToAdulterated":20,"milkSource":"","labTerminology":"POSITIVE","chemicalReport":{"purpose":"Used to thicken diluted milk, restoring viscosity, creaminess, and lactometer density after water dilution.","snfImpact":"Falsely restores total solid readings by adding complex carbohydrates instead of natural milk fat and proteins.","densityImpact":"Increases specific gravity from watered readings (<1.026) back into the normal range (1.028–1.032 g/cm³).","chemicalMechanism":"Iodine-starch inclusion reaction: Triiodide (I₃⁻) ions insert into the amylose helix, creating an intense dark blue-black charge transfer complex.","healthHazards":["Rapid blood glucose spikes, dangerous for diabetic individuals","Severe indigestion, diarrhea, and colic in infants","Prevents absorption of natural calcium and casein proteins in the gastrointestinal tract","Promotes rapid microbial fermentation and souring"],"fssaiLimit":"Nil tolerance (0.0%). Any presence of external starch or maltodextrin indicates adulteration."},"notes":"","sampleName":"Milk Sample","createdAt":{"$$date":1792416604119},"_id":"v0EjHxvI3B0ZYQdc"}

{"userId":"eWfNO4AfHG7awdav","userEmail":"annabond2704@gmail.com","adulterantSlug":"formalin","adulterantName":"Formalin (Formaldehyde)","imageUrl":"/uploads/strip-1792417069944-834391921.jpeg","sampledColorHex":"#880146","sampledColorRgb":[136,1,70],"detectedStatus":"ADULTERATED","confidenceScore":70,"distanceToPure":138,"distanceToAdulterated":128,"milkSource":"amul","labTerminology":"POSITIVE","chemicalReport":{"purpose":"Illegally used as a preservative to prevent bacterial spoilage and extend shelf life of adulterated or stale milk for days without refrigeration.","snfImpact":"Does not directly affect SNF readings; masks microbial activity that would otherwise cause souring and curdling detectable by standard tests.","densityImpact":"Minimal effect on density; makes stale milk appear fresh by inhibiting fermentation-driven density changes.","chemicalMechanism":"Schiff reagent (fuchsin-sulfurous acid) or KMnO₄ decolorization reaction: formaldehyde oxidizes the reagent producing a vivid magenta-crimson to deep violet chromophore complex. In the absence of formalin, strips remain off-white or pale.","healthHazards":["Classified as a Group 1 human carcinogen (IARC) — directly linked to nasopharyngeal and leukemia cancers","Acute oral toxicity: corrosive necrosis of esophagus, stomach mucosa, and intestinal lining","Severe hepatotoxicity and irreversible liver cirrhosis with chronic exposure","Respiratory damage, chronic bronchitis, and mucosal inflammation","Systemic neurotoxicity with memory impairment, motor dysfunction, and CNS depression"],"fssaiLimit":"Absolute zero tolerance (0.0 ppm). Formalin is strictly banned under FSSAI Food Safety & Standards (Contaminants, Toxins and Residues) Regulations."},"notes":"","sampleName":"Milk Sample","createdAt":{"$$date":1792417069946},"_id":"wibwuHx6JDLnTn0y"}

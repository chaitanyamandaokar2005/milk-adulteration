{"userId":"eUuhMyzhWCwO8Cn8","userEmail":"analyst_1792422937432@milklab.in","adulterantSlug":"starch","adulterantName":"Starch / Maltodextrin","imageUrl":"/uploads/strip-1792422937782-701319218.jpg","sampledColorHex":"#120F0B","sampledColorRgb":[18,15,11],"detectedStatus":"ADULTERATED","confidenceScore":99,"distanceToPure":148,"distanceToAdulterated":0,"milkSource":"Fresh Farm Dairy","labTerminology":"POSITIVE","chemicalReport":{"purpose":"Used to thicken diluted milk, restoring viscosity, creaminess, and lactometer density after water dilution.","snfImpact":"Falsely restores total solid readings by adding complex carbohydrates instead of natural milk fat and proteins.","densityImpact":"Increases specific gravity from watered readings (<1.026) back into the normal range (1.028–1.032 g/cm³).","chemicalMechanism":"Iodine-starch inclusion reaction: Triiodide (I₃⁻) ions insert into the amylose helix, creating an intense dark blue-black charge transfer complex.","healthHazards":["Rapid blood glucose spikes, dangerous for diabetic individuals","Severe indigestion, diarrhea, and colic in infants","Prevents absorption of natural calcium and casein proteins in the gastrointestinal tract","Promotes rapid microbial fermentation and souring"],"fssaiLimit":"Nil tolerance (0.0%). Any presence of external starch or maltodextrin indicates adulteration."},"notes":"","sampleName":"Starch - Right Strip (Adulterated)","createdAt":{"$$date":1792422937786},"_id":"IbTflLTX3SZpsp2f"}

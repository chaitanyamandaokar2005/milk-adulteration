{"userId":"eWfNO4AfHG7awdav","userEmail":"annabond2704@gmail.com","adulterantSlug":"formalin","adulterantName":"Formalin (Formaldehyde)","imageUrl":"/uploads/strip-1792421437647-953310501.jpeg","sampledColorHex":"#890249","sampledColorRgb":[137,2,73],"detectedStatus":"ADULTERATED","confidenceScore":70,"distanceToPure":136,"distanceToAdulterated":128,"milkSource":"vendor","labTerminology":"POSITIVE","chemicalReport":{"purpose":"Illegally used as a preservative to prevent bacterial spoilage and extend shelf life of adulterated or stale milk for days without refrigeration.","snfImpact":"Does not directly affect SNF readings; masks microbial activity that would otherwise cause souring and curdling detectable by standard tests.","densityImpact":"Minimal effect on density; makes stale milk appear fresh by inhibiting fermentation-driven density changes.","chemicalMechanism":"Schiff reagent (fuchsin-sulfurous acid) or KMnO₄ decolorization reaction: formaldehyde oxidizes the reagent producing a vivid magenta-crimson to deep violet chromophore complex. In the absence of formalin, strips remain off-white or pale.","healthHazards":["Classified as a Group 1 human carcinogen (IARC) — directly linked to nasopharyngeal and leukemia cancers","Acute oral toxicity: corrosive necrosis of esophagus, stomach mucosa, and intestinal lining","Severe hepatotoxicity and irreversible liver cirrhosis with chronic exposure","Respiratory damage, chronic bronchitis, and mucosal inflammation","Systemic neurotoxicity with memory impairment, motor dysfunction, and CNS depression"],"fssaiLimit":"Absolute zero tolerance (0.0 ppm). Formalin is strictly banned under FSSAI Food Safety & Standards (Contaminants, Toxins and Residues) Regulations."},"notes":"","sampleName":"Milk Sample","createdAt":{"$$date":1792421437650},"_id":"6df7mzM3nrzAfxSR"}
{"userId":"Ft2lHPf0gIju3UTl","userEmail":"expert@dairylab.org","adulterantSlug":"detergent","adulterantName":"Detergent / Commercial Soap","imageUrl":"/uploads/strip-1792406718099-456126018.png","sampledColorHex":"#2B313A","sampledColorRgb":[43,49,58],"detectedStatus":"ADULTERATED","confidenceScore":99,"distanceToPure":241,"distanceToAdulterated":0,"chemicalReport":{"purpose":"Added to create artificial dense froth, emulsify cheap vegetable oils with water, and produce synthetic milk.","snfImpact":"Distorts standard colloidal balance and alters fat globule dispersion properties.","densityImpact":"Maintains uniform suspension of adulterated fats without spontaneous phase separation.","chemicalMechanism":"Anionic surfactant displacement reaction with cationic dye (e.g., bromocresol purple or pinacyanol) resulting in a dark slate-blue precipitation.","healthHazards":["Corrosive injury to esophagus, stomach lining, and intestines","Acute alkaline gastroenteritis and persistent vomiting","Alkaline poisoning causing disruption of systemic enzyme pathways","Chronic toxic stress on liver filtration systems"],"fssaiLimit":"Zero tolerance (0.0%). Absolutely prohibited in food products."},"notes":"Unusual stable foam noted","sampleName":"Synthetic Frothy Milk Test","createdAt":{"$$date":1792406718104},"_id":"6fnzNq4Zo7FKln7U"}

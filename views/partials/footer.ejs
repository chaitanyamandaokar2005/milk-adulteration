  <% if (layout !== 'auth') { %>
  <footer class="glass-footer">
    <div class="container footer-content-wrap">
      <div class="footer-grid">
        
        <!-- Brand Info -->
        <div class="footer-col footer-col-brand">
          <a href="/" class="footer-brand">
            <span class="footer-brand-icon">🥛</span>
            <div class="footer-brand-text">
              <span class="footer-brand-title">MilkWise</span>
              <span class="footer-brand-tagline">Milk Purity Intelligence</span>
            </div>
          </a>
          <p class="footer-desc">
            Precision colorimetric milk test strip intelligence engine. Digital chemical screening calibrated against certified laboratory standards.
          </p>
          <div class="footer-badges-row">
            <span class="footer-pill-badge fssai-badge">
              <span class="pill-dot green"></span>
              FSSAI Standard Aligned
            </span>
            <span class="footer-pill-badge live-badge">
              <span class="pill-dot cyan"></span>
              Real-time Colorimetry
            </span>
          </div>
        </div>

        <!-- Navigation Links -->
        <div class="footer-col">
          <h4 class="footer-heading">Platform</h4>
          <ul class="footer-nav-list">
            <li><a href="/" class="footer-link">Home Overview</a></li>
            <li><a href="/test" class="footer-link">Run Strip Test</a></li>
            <li><a href="/calibration" class="footer-link">Color Standards</a></li>
            <li><a href="/adulterants" class="footer-link">Adulterants Guide</a></li>
            <li><a href="/dashboard" class="footer-link">Test Dashboard</a></li>
          </ul>
        </div>

        <!-- Calibration Standards Summary -->
        <div class="footer-col">
          <h4 class="footer-heading">4 Calibrated Standards</h4>
          <div class="footer-standards-list">
            <div class="footer-std-item">
              <span class="std-swatch-pair">
                <i style="background:#5A051E;" title="Pure Control (Normal)"></i>
                <i style="background:#3E1A58;" title="Adulterated"></i>
              </span>
              <span class="std-name">1. Formalin (Preservative)</span>
            </div>
            <div class="footer-std-item">
              <span class="std-swatch-pair">
                <i style="background:#B6B3A4;" title="Pure Control (Normal)"></i>
                <i style="background:#B0B63B;" title="Adulterated"></i>
              </span>
              <span class="std-name">2. Urea (Nitrogen)</span>
            </div>
            <div class="footer-std-item">
              <span class="std-swatch-pair">
                <i style="background:#594214;" title="Pure Control (Normal)"></i>
                <i style="background:#120F0B;" title="Adulterated"></i>
              </span>
              <span class="std-name">3. Starch (Thickener)</span>
            </div>
            <div class="footer-std-item">
              <span class="std-swatch-pair">
                <i style="background:#856E72;" title="Pure Control (Normal)"></i>
                <i style="background:#3A3B39;" title="Adulterated"></i>
              </span>
              <span class="std-name">4. Detergent (Emulsifier)</span>
            </div>
          </div>
        </div>

        <!-- Safety & Disclaimer -->
        <div class="footer-col">
          <h4 class="footer-heading">Diagnostic Notice</h4>
          <p class="footer-notice-text">
            MilkWise provides rapid digital screening by comparing chemical reaction pads against calibrated hex colorimetry.
          </p>
          <div class="footer-compliance-card">
            <span class="comp-icon">⚖️</span>
            <div>
              <strong>Binary Diagnosis:</strong>
              <p>Strictly reports <strong>NEGATIVE</strong> (safe/pure milk) or <strong>POSITIVE</strong> (adulterated/unsafe).</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Bottom Bar -->
      <div class="footer-bottom-bar">
        <div class="footer-copy">
          &copy; <%= new Date().getFullYear() %> <strong>MilkWise</strong>. Precision Food Safety Intelligence.
        </div>
        <div class="footer-meta-tags">
          <span class="meta-tag">FSSAI Zero-Tolerance Mode</span>
          <span class="meta-tag">Left: Normal / Right: Adulterated</span>
        </div>
      </div>
    </div>
  </footer>
  <% } %>

  <div class="toast-container" id="toastContainer"></div>

  <script src="/js/auth.js"></script>
  <script src="/js/app.js"></script>
  <% (scripts || []).forEach(function(src) { %>
  <script src="<%= src %>"></script>
  <% }) %>
</body>
</html>

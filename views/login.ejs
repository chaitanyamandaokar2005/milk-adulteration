<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="auth-page">
  <div class="auth-split">
    <section class="auth-panel-copy">
      <p class="hero-tag">Welcome back</p>
      <h1>Sign in to test strips and keep certificates</h1>
      <p>Your dashboard stores every POSITIVE / NEGATIVE result with sampled pad colors and milk source.</p>
    </section>
    <section class="auth-panel-form">
      <div class="card auth-card">
        <h2>Login</h2>
        <p class="auth-card-lead">Use your email or username.</p>
        <form id="loginForm">
          <div class="form-group">
            <label class="form-label" for="loginIdentifier">Email or username</label>
            <input type="text" id="loginIdentifier" class="form-input" placeholder="you@example.com" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="loginPassword">Password</label>
            <input type="password" id="loginPassword" class="form-input" placeholder="••••••••" required />
          </div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%; margin-top:20px;">Log in</button>
        </form>
        <p class="modal-switch-text">Need an account? <a href="/register">Sign up</a></p>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>

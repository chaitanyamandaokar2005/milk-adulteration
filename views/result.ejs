<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="page-shell result-page" id="main">
  <div class="container result-layout">
    <div class="result-empty" id="resultPlaceholder">
      <div class="card empty-auth-card">
        <h1>No result on this page yet</h1>
        <p>Run a strip test first. After analysis you are sent here with the positive / negative report.</p>
        <a class="btn btn-primary" href="/test">Go to Test Strip</a>
      </div>
    </div>

    <div id="resultContent" style="display:none;">
      <div class="result-toolbar">
        <a class="btn btn-outline btn-sm" href="/test">New strip test</a>
        <div class="result-toolbar-actions">
          <a class="btn btn-ghost btn-sm" href="/dashboard">Dashboard</a>
          <button class="btn btn-primary btn-sm" id="printReportBtn" type="button">Print certificate</button>
        </div>
      </div>

      <article class="card certificate-card official-report" id="resultWindow">
        <header class="lab-report-header" id="labReportHeader">
          <div class="print-letterhead">
            <div class="print-brand">
              <span class="print-mark" aria-hidden="true"></span>
              <div>
                <div class="lab-report-label">MilkWise Laboratory</div>
                <div class="lab-report-subtitle">Colorimetric screening record — not a certified lab report</div>
              </div>
            </div>
            <div class="lab-report-meta">
              <div class="lab-report-id" id="labReportId">Report #—</div>
              <div class="lab-report-date" id="labReportDate">—</div>
            </div>
          </div>
          <dl class="report-particulars">
            <div>
              <dt>Sample</dt>
              <dd id="reportSampleName">—</dd>
            </div>
            <div>
              <dt>Milk source</dt>
              <dd id="reportMilkSource">—</dd>
            </div>
            <div>
              <dt>Analyte tested</dt>
              <dd id="reportAnalyte">—</dd>
            </div>
            <div>
              <dt>Analyst</dt>
              <dd id="reportAnalyst">—</dd>
            </div>
          </dl>
        </header>

        <div class="status-banner pure" id="statusBanner">
          <div class="status-badge-text">
            <span id="statusIcon" style="font-size:28px;">✓</span>
            <div>
              <h3 id="statusHeading">NEGATIVE — PURE MILK</h3>
              <p id="statusSubtitle">No hazardous adulterant detected</p>
            </div>
          </div>
          <div class="status-right">
            <span class="confidence-pill" id="confidencePill">—</span>
            <span class="result-terminology-badge negative-badge" id="terminologyBadge">NEGATIVE</span>
          </div>
        </div>

        <div class="terminology-bar" id="terminologyBar">
          <strong id="termBarLabel">NEGATIVE</strong>: <span id="termBarDesc">No adulterant detected — milk is pure and safe for consumption</span>
        </div>

        <div class="color-match-card">
          <div class="color-triad">
            <div class="triad-box">
              <div class="triad-swatch" id="sampledSwatchBox"></div>
              <div class="triad-label">Your strip pad</div>
              <div class="triad-hex copyable" id="sampledHexText" data-copy="" title="Copy hex">#000000</div>
              <div class="triad-metric" id="sampledMetricText">Sampled color</div>
            </div>
            <div class="triad-box">
              <div class="triad-swatch" id="pureSwatchBox"></div>
              <div class="triad-label">Normal (left standard)</div>
              <div class="triad-hex copyable" id="pureHexText" data-copy="" title="Copy hex">#000000</div>
              <div class="triad-metric" id="pureDistMetric">ΔE: 0</div>
            </div>
            <div class="triad-box">
              <div class="triad-swatch" id="adultSwatchBox"></div>
              <div class="triad-label">Adulterated (right standard)</div>
              <div class="triad-hex copyable" id="adultHexText" data-copy="" title="Copy hex">#000000</div>
              <div class="triad-metric" id="adultDistMetric">ΔE: 0</div>
            </div>
          </div>
        </div>

        <div class="report-grid">
          <div class="report-item">
            <div class="report-item-title">Why it is added</div>
            <div class="report-item-body" id="reportPurpose">-</div>
          </div>
          <div class="report-item">
            <div class="report-item-title">SNF &amp; density impact</div>
            <div class="report-item-body">
              <strong id="reportSnf">-</strong><br />
              <span id="reportDensity" style="font-size:0.8rem; color:var(--text-muted);">-</span>
            </div>
          </div>
          <div class="report-item">
            <div class="report-item-title">Chemical reaction</div>
            <div class="report-item-body" id="reportMechanism">-</div>
          </div>
          <div class="report-item">
            <div class="report-item-title" style="color:var(--danger-red);">Health hazards</div>
            <ul class="hazard-list" id="reportHazards"></ul>
          </div>
        </div>

        <div class="fssai-box">
          <strong>Regulatory standard (FSSAI):</strong> <span id="reportFssai">-</span>
        </div>

        <div class="lab-report-footer">
          <p class="print-disclaimer">
            This is a digital color-match screening record, not an accredited laboratory certificate and not an FSSAI test report.
            <span class="term-mini negative-term">NEGATIVE</span> = closer to the normal pad &nbsp;
            <span class="term-mini positive-term">POSITIVE</span> = closer to the adulterated pad.
            Confirm with an accredited laboratory where legally required.
          </p>
        </div>
      </article>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<section class="print-sheet" id="printSheet" aria-hidden="true">
  <aside class="ps-rail"><span>MilkWise Laboratory · Screening certificate · Not a wet-lab substitute</span></aside>
  <div class="ps-page">
    <div class="ps-stub">
      <span class="ps-serial" id="psSerial">MW-0000</span>
      <span class="ps-issued" id="psIssued">—</span>
    </div>

    <header class="ps-head">
      <p class="ps-kicker">Instrument of analysis</p>
      <h1>Certificate of milk purity</h1>
      <p class="ps-sub">Colorimetric pad matching against calibrated hex standards</p>
    </header>

    <div class="ps-verdict is-negative" id="psVerdictWrap">
      <p class="ps-verdict-word" id="psVerdict">NEGATIVE</p>
      <p class="ps-verdict-mean" id="psVerdictMean">No adulterant detected in the sampled pad</p>
      <div class="ps-stamp" id="psStamp">PASSED</div>
    </div>

    <table class="ps-ledger">
      <tbody>
        <tr>
          <th>Sample</th><td id="psSample">—</td>
          <th>Source</th><td id="psSource">—</td>
        </tr>
        <tr>
          <th>Analyte</th><td id="psAnalyte">—</td>
          <th>Confidence</th><td id="psConfidence">—</td>
        </tr>
        <tr>
          <th>Method</th>
          <td colspan="3">ΔE nearest-neighbour · left pad = normal</td>
        </tr>
      </tbody>
    </table>

    <div class="ps-chips">
      <figure>
        <div class="ps-chip" id="psChipSampled"></div>
        <figcaption>Sampled pad<br><code id="psHexSampled">—</code></figcaption>
      </figure>
      <figure>
        <div class="ps-chip" id="psChipPure"></div>
        <figcaption>Normal standard<br><code id="psHexPure">—</code><br><span id="psDePure"></span></figcaption>
      </figure>
      <figure>
        <div class="ps-chip" id="psChipAdult"></div>
        <figcaption>Adulterated standard<br><code id="psHexAdult">—</code><br><span id="psDeAdult"></span></figcaption>
      </figure>
    </div>

    <p class="ps-finding" id="psFinding">—</p>
    <p class="ps-rule" id="psFssai">—</p>

    <p class="ps-micro">
      Screening record only — not a certified lab result or official FSSAI certificate. Reproduce in full. Enable background graphics when printing.
      NEGATIVE = closer to the normal pad · POSITIVE = closer to the adulterated pad.
    </p>
  </div>
</section>

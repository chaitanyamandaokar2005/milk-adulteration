<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="auth-page">
  <div class="auth-split">
    <section class="auth-panel-copy">
      <p class="hero-tag">Create account</p>
      <h1>Save strip results and milk-source certificates</h1>
      <p>Free accounts unlock the analyzer, history, and printable reports.</p>
    </section>
    <section class="auth-panel-form">
      <div class="card auth-card">
        <h2>Sign up</h2>
        <p class="auth-card-lead">Takes less than a minute.</p>
        <form id="registerForm">
          <div class="form-group">
            <label class="form-label" for="regFullName">Full name</label>
            <input type="text" id="regFullName" class="form-input" placeholder="e.g. Dr. Jane Smith" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="regUsername">Username</label>
            <input type="text" id="regUsername" class="form-input" placeholder="e.g. janesmith" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="regEmail">Email</label>
            <input type="email" id="regEmail" class="form-input" placeholder="jane@dairy.com" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="regPassword">Password (min 6 characters)</label>
            <input type="password" id="regPassword" class="form-input" placeholder="••••••••" minlength="6" required />
          </div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%; margin-top:20px;">Create account</button>
        </form>
        <p class="modal-switch-text">Already registered? <a href="/login">Log in</a></p>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>

# Copy to .env for local runs. On Render, set these in the dashboard — do not commit .env.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Required. Local Mongo or Atlas:
# mongodb://127.0.0.1:27017/milkwise
# mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/milkwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/milkwise

# Required. Long random string. Production refuses values containing "change-me".
JWT_SECRET=change-me-to-a-long-random-secret

# Optional. Not AWS. Only if you want strip photos to survive Render restarts.
# Leave blank to store photos on local disk (they disappear on most PaaS restarts; test records still save in Mongo).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
